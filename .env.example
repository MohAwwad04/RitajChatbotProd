# ---- LLM serving (OpenAI-compatible endpoint) ----
# DEV default: Ollama on your Mac/PC.  Run:  ollama pull gemma4:e4b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama            # Ollama ignores this; any non-empty string works
LLM_MODEL=gemma4:e4b          # use gemma4:e2b on lighter machines

# PROD (GPU server, vLLM) — just swap the two lines above for these:
# LLM_BASE_URL=http://gpu-host:8000/v1
# LLM_MODEL=google/gemma-4-26B-A4B-it

# ---- Embeddings (runs locally, CPU is fine) ----
EMBED_MODEL=intfloat/multilingual-e5-large   # lighter option: intfloat/multilingual-e5-base

# ---- Reranker (cross-encoder, multilingual; downloads ~600 MB on first use) ----
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- Vector store (Qdrant; run it with:  docker run -p 6333:6333 qdrant/qdrant) ----
QDRANT_URL=http://localhost:6333
COLLECTION=ritaj

# ---- Retrieval ----
TOP_K=6

# ---- Operator console (per-user login) ----
# REQUIRED on any public deployment. Admin accounts as "username:bcrypt_hash"
# pairs, comma-separated (hashes ONLY — never plaintext). Generate each with:
#   python -m ritaj.adminauth hash <username>
# When set, /admin/* requires a session token from POST /admin/login (the
# /admin page shows a login screen). Leave empty ONLY for local dev.
ADMIN_USERS=
# Signs admin session tokens. Set a long random value so logins survive
# restarts:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# How long a login stays valid (hours). Default 12.
# SESSION_TTL_HOURS=12

# Legacy fallback: a single shared token, used ONLY when ADMIN_USERS is empty.
# Prefer ADMIN_USERS above. Leave empty for local dev.
ADMIN_TOKEN=

# ---- Runtime writers (optional) ----
# Where the chat log (/admin Log tab) and live calibration overrides are
# written. start.sh defaults both to /tmp/... for the container deploy, where
# the app dir is read-only. Local dev keeps the repo-root files.
# CHAT_LOG_PATH=chat_log.jsonl
# CALIBRATION_PATH=calibration.json

# ---- Conversation memory bounds ----
# Clients replay their prior turns with each request (the server is stateless);
# these clamp what the server will actually accept into the prompt.
# HISTORY_MAX_TURNS=8
# HISTORY_MAX_CHARS=1500

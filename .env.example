# ---- Which deployment is this ----
# "production" turns on the fail-closed checks: admin auth must be configured,
# CORS must be an explicit allowlist, the LLM key must be real, and the slow
# in-process index build is refused. Anything else is development.
ENVIRONMENT=development

# ---- LLM serving (OpenAI-compatible endpoint) ----
# DEV default: Ollama on your Mac/PC.  Run:  ollama pull gemma4:e4b
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama            # Ollama ignores this; any non-empty string works
LLM_MODEL=gemma4:e4b          # use gemma4:e2b on lighter machines

# PILOT (Cloudflare Workers AI — see docs/adr/ADR-001-llm-provider.md).
# Workers AI serves Gemma 4 through an OpenAI-compatible endpoint, so only these
# three values change. The token is a SERVER-SIDE SECRET: it belongs in the host's
# secret store, never in this file, in git, or in the extension package.
# LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# LLM_MODEL=@cf/google/gemma-4-26b-a4b-it
# LLM_API_KEY=<CLOUDFLARE_API_TOKEN scoped to Workers AI inference only>

# SELF-HOSTED (Oracle Always Free A1 + Ollama — docs/DEPLOY_GEMMA4.md §2).
# Bind Ollama to loopback and put HTTPS + a bearer token in front of it; never
# expose port 11434.
# LLM_BASE_URL=https://gemma.your-host.example/v1
# LLM_MODEL=gemma4:e2b
# LLM_API_KEY=<long random bearer token checked by the reverse proxy>

# Daily budget, in the unit the provider actually meters. Cloudflare's free
# Workers AI allowance is 10,000 neurons/day; 9,000 leaves headroom so the
# service returns a controlled message instead of the provider's error.
#
# Counted from the provider's usage block at each call, so the extra call that
# follow-up condensation makes is included — the old per-answer count missed it.
# A representative RAG request (4,000 in + 500 out) is ~50 neurons, so 9,000 is
# roughly 180 answers. 0 disables the guard (development only).
LLM_DAILY_NEURON_BUDGET=9000
# Optional coarse cap on raw provider calls regardless of size. 0 = off.
# LLM_DAILY_CALL_CAP=0
# Neurons per million tokens, derived from Cloudflare's published prices for
# @cf/google/gemma-4-26b-a4b-it ($0.10/M in, $0.30/M out) at $0.011/1000 neurons.
# NEURONS_PER_M_INPUT=9091
# NEURONS_PER_M_OUTPUT=27273

# ---- Embeddings (runs locally, CPU is fine) ----
EMBED_MODEL=intfloat/multilingual-e5-large   # lighter option: intfloat/multilingual-e5-base

# ---- Reranker (cross-encoder, multilingual; downloads ~600 MB on first use) ----
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ---- Vector store (Qdrant; run it with:  docker run -p 6333:6333 qdrant/qdrant) ----
#
# QDRANT_MODE makes the choice explicit rather than inferring it from which
# variable happens to be non-empty. That inference was a real hazard: a
# deployment carrying both a cloud URL and a leftover QDRANT_PATH ran embedded
# against an empty directory and reported itself healthy, which from the outside
# is indistinguishable from an empty corpus.
#
#   embedded  local disk at QDRANT_PATH, no separate service (the container)
#   remote    a Qdrant server at QDRANT_URL (+ QDRANT_API_KEY for Qdrant Cloud)
#   auto      legacy inference: path if set, else url
QDRANT_MODE=remote
QDRANT_URL=http://localhost:6333
COLLECTION=ritaj

# Qdrant Cloud Free (0.5 vCPU, 1 GB RAM, 4 GB disk, no card). Production
# refuses plain http and refuses a missing key.
# QDRANT_MODE=remote
# QDRANT_URL=https://<cluster>.<region>.cloud.qdrant.io:6333
# QDRANT_API_KEY=<host secret — never commit this>
# QDRANT_TIMEOUT_SECONDS=10

# The name clients read. Indexing writes ritaj_<corpus-version> and moves this
# alias only after the new collection verifies, so a rebuild never points the
# live name at a half-filled collection and the previous one survives for an
# instant rollback. Leave empty to read COLLECTION directly.
# QDRANT_COLLECTION_ALIAS=ritaj_current

# ---- Retrieval ----
TOP_K=6

# ---- Operator console (per-user login) ----
# REQUIRED on any public deployment. Admin accounts as "username:bcrypt_hash"
# pairs, comma-separated (hashes ONLY — never plaintext). Generate each with:
#   python -m ritaj.adminauth hash <username>
# When set, /admin/* requires a session token from POST /admin/login (the
# /admin page shows a login screen). Leave empty ONLY for local dev.
ADMIN_USERS=
# Signs admin session tokens. Set a long random value so logins survive
# restarts:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# How long a login stays valid (hours). Default 12.
# SESSION_TTL_HOURS=12

# Legacy fallback: a single shared token, used ONLY when ADMIN_USERS is empty.
# Prefer ADMIN_USERS above. Leave empty for local dev.
ADMIN_TOKEN=

# ---- Runtime writers (optional) ----
# Where the chat log (/admin Log tab) and live calibration overrides are
# written. start.sh defaults both to /tmp/... for the container deploy, where
# the app dir is read-only. Local dev keeps the repo-root files.
# CHAT_LOG_PATH=chat_log.jsonl
# CALIBRATION_PATH=calibration.json

# ---- Conversation memory bounds ----
# Clients replay their prior turns with each request (the server is stateless);
# these clamp what the server will actually accept into the prompt.
# HISTORY_MAX_TURNS=8
# HISTORY_MAX_CHARS=1500

# ---- Public-service controls (REQUIRED in production) ----
# CORS allowlist. Production refuses to start with "*" or an empty list: the
# chat endpoint spends metered LLM quota, so any site being able to call it is a
# way to lose the day's allowance to someone else's page.
# CORS_ORIGINS=https://mohawwad04-ritaj-rag.hf.space
# The published Chrome Web Store extension id, expanded to chrome-extension://<id>.
# Known only after the first store submission.
# EXTENSION_ID=

# Per-SESSION limits. The session id is client-supplied, so these bound one
# conversation, not one attacker — a hostile client can mint a new id.
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_HOUR=60
# RATE_LIMIT_PER_DAY=150

# Per-NETWORK limits. A client cannot change its address, so this is the limit
# that actually holds. Higher than the session limits because a campus NAT puts
# many honest students behind one address.
# NETWORK_RATE_LIMIT_PER_MINUTE=30
# NETWORK_RATE_LIMIT_PER_HOUR=200
# NETWORK_RATE_LIMIT_PER_DAY=400

# How many proxies sit in front of this deployment. 0 = ignore X-Forwarded-For
# entirely (safe against spoofing, but behind a proxy every student shares one
# bucket and the network limit becomes global). On Hugging Face Spaces this is
# normally 1 — CONFIRM against the host before setting it: too high a value lets
# a client choose its own rate-limit bucket. /ready reports which case you are in
# under "client_addressing".
# TRUSTED_PROXY_COUNT=0

# Simultaneous generations. A 2-vCPU host with one model copy cannot usefully
# run more, and unbounded concurrency is how a free quota disappears in a minute.
# MAX_CONCURRENT_GENERATIONS=2
# QUEUE_TIMEOUT_SECONDS=10

# Request size caps. The prompt is built from these, so they cap cost.
# MAX_MESSAGE_CHARS=2000
# MAX_BODY_BYTES=32768

# ---- Telemetry + retention ----
# "aggregate" (default): verdicts, latencies, source ids — no question or answer
# text. "full": stores redacted conversation text, and requires an explicit
# in-product opt-in plus a stated retention period before you turn it on.
# CHAT_LOG_MODE=aggregate
# CHAT_LOG_RETENTION_DAYS=30

# ---- Startup ----
# Where the embedded Qdrant store lives. The container sets /tmp/qdrant because
# the app directory is read-only on HF Spaces.
# QDRANT_PATH=/tmp/qdrant
# Production serves a prebuilt corpus artifact (scripts/build_index.py --publish).
# Building at boot is what caused the Hugging Face launch timeout.
# ALLOW_INDEX_BUILD_ON_BOOT=0
# Set to 0 in tests/CLI so importing the app doesn't load a 2 GB embedder.
# STARTUP_INIT=1

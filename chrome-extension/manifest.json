{
  "manifest_version": 3,
  "name": "Ritaj Assistant — Birzeit University (independent)",
  "short_name": "Ritaj Assistant",
  "version": "1.1.0",
  "description": "Independent student-built helper for the Ritaj portal. Ask in Arabic or English and open the right Ritaj page. Not an official Birzeit service.",
  "action": {
    "default_title": "Ritaj Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://mohawwad04-ritaj-rag.hf.space/*"]
}

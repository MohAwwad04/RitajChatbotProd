# ---- Node ----
node_modules/
*.tsbuildinfo

# ---- Packaged artifacts / logs ----
ritaj-assistant-extension.zip
*.log

# Generated per-release: the manifest and SBOM are written into the deployed
# tree by scripts/deploy_space.py, and regenerated from the tag on demand.
# Committing them would mean a stale copy is what a reviewer reads.
release/

# Built corpus artifacts. data/corpus/CURRENT and the artifact directories are
# build outputs; the manifest that produces them (data/sources.yaml) is tracked.
data/corpus/

# Operator plaintext — generated locally, moved to a password manager, deleted.
# Untracked is not enough: one `git add -A` turns an untracked secret into a
# committed one, and ritaj_rag_admins.rtf is why this project knows that.
OPERATOR-PASSWORD.txt

# ---- Secrets / local config ----
.env
.env.local
# Plaintext operator credentials. Never commit: /admin accounts are configured
# from bcrypt hashes in ADMIN_USERS (see scripts/set_admins.py), so the cleartext
# list has no reason to exist in the repo.
ritaj_rag_admins.rtf
*_admins.rtf
secrets/

# ---- Python virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Python bytecode / build artifacts ----
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.Python
dist/
build/

# ---- Generated / runtime data (rebuilt with scripts/build_index.py) ----
qdrant_storage/

# ---- Caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
htmlcov/

